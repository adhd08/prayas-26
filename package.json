{
  "name": "prayas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:api": "uv run --directory backend uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:api": "uv run --directory backend pytest",
    "lint:api": "uv run --directory backend ruff check .",
    "api:types": "uv run --directory backend python scripts/export-openapi.py && npm --prefix frontend run api:types"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}

# Sylvida frontend configuration.
# Copy to .env.local and adjust. Every value is optional: with none of them set
# the app runs entirely on the bundled mock service layer.

# When "false", lib/api/* switches from the mock services to live HTTP calls.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Base URL the backend team will point at (ignored while mock mode is on).
NEXT_PUBLIC_API_BASE_URL=

# Demo city the simulator opens on.
NEXT_PUBLIC_DEMO_CITY_LAT=22.5726
NEXT_PUBLIC_DEMO_CITY_LNG=88.3639
NEXT_PUBLIC_DEMO_CITY_ZOOM=13
